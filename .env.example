# ========================================================
# JUNTO OPERATIONS DASHBOARD - ENVIRONMENT CONFIGURATION
# ========================================================

# 1. Dashboard Password Gate (Used to log into /login)
DASHBOARD_PASSWORD=junto-admin-2026

# 2. Encrypted Session Secret (At least 32 characters long for AES-256 session token encryption)
SESSION_SECRET=junto-super-secure-encryption-secret-key-32chars-min

# 3. Junto Django Backend REST API URL (No trailing slash)
# For local development: http://localhost:8000
# For production (Render/Railway/Custom): https://api.junto.app
BACKEND_API_URL=http://localhost:8000

# 4. Master Ops Header Secret (Must match BACKEND_OPS_KEY in Django settings)
BACKEND_OPS_KEY=junto-ops-secret-key-2026
